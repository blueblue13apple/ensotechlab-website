---
<header>
  <div class="container">
    <div class="logo">
      <a href="/">Enso Tech Lab</a>
    </div>
    <nav>
      <ul>
        <li><a href="/">ホーム</a></li>
        <li><a href="/about-us">私たちについて</a></li>
        <li><a href="/solutions">ソリューション</a></li>
        <li><a href="/news">ニュース</a></li>
        <li><a href="/contact">お問い合わせ</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    /* ★変更点: 八ヶ岳の森林と空グラデーション */
    background: linear-gradient(to right, #2e574c, #5ea89a); /* 左から右へ */
    color: #fff; /* テキストは白 */
    padding: 20px 0;
    position: fixed;
    width: 100%;
    top: 0;
    left: 0;
    z-index: 1000;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3); /* 影を少し強めに */
  }
  header .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .logo a {
    color: #fff; /* ロゴも白 */
    text-decoration: none;
    font-size: 1.8em;
    font-weight: bold;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  nav li {
    margin-left: 30px;
  }
  nav a {
    color: #fff; /* ナビリンクも白 */
    text-decoration: none;
    font-weight: bold;
    transition: color 0.3s ease;
  }
  nav a:hover {
    /* ホバー時は global.css の --primary-color を使うか、別の鮮やかな色 */
    color: var(--primary-color); /* 例: #007bff */
    /* あるいは、もっと自然寄りの明るい色 #B0E0E6 (パウダーブルー) なども検討 */
  }

  /* レスポンシブ対応は変更なし */
  @media (max-width: 768px) {
    header .container {
      flex-direction: column;
      align-items: flex-start;
    }
    nav ul {
      flex-direction: column;
      width: 100%;
      margin-top: 15px;
    }
    nav li {
      margin: 10px 0;
      width: 100%;
    }
    nav a {
      display: block;
      padding: 5px 0;
    }
  }
</style>